    else:
        print(f"\n{d['fehler']} Fehler, {d['hinweise']} Hinweise.")
    sys.exit(1 if d["fehler"] else 0)


def cmd_abgabe(a):
    """Die Freigabe vor der Abgabe - ein Befehl, der Nein sagen kann.

    Die Erklaerung wird von Hand in Mein Elster uebertragen; es gibt keinen
    Knopf, den ein Programm sperren koennte. Was sich sperren laesst, ist die
    Aussage "sie ist fertig". Genau die gibt dieser Befehl - oder eben nicht,
    mit Rueckgabewert 1, damit auch ein Skript daran haengen kann.
    """
    from bhl import fristen, pruefung, reports
    from bhl import steuern as st
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    g = gj(con, m["id"], a.jahr)
    rahmen = rahmen_aus_mandant(m)
    jd = jahr_dir(a.mandant, a.jahr)

    spec = st.laden(jd)
    if spec is None:
        sys.exit(f"Fehlt: {os.path.join(jd, 'steuern.json')}")
    # Die Ueberleitung gegen die Kontensalden halten. Ohne diesen Schritt
    # traegt die Freigabe nur die Buchfuehrung, nicht die Erklaerung - ein
    # Zahlendreher in steuern.json kaeme ungeprueft durch.
    spec = st.pruefen(con, g, spec, reports.ergebnis(con, g))
    offen = st.platzhalter(spec)

    art = "einkommensteuer" if rahmen.ueberschussrechnung else "koerperschaftsteuer"
    ende = con.execute("SELECT ende FROM geschaeftsjahr WHERE id=?", (g,)).fetchone()[0]
    import datetime as _dt
    termine = fristen.jahrespflichten(
        mandant_dir(a.mandant), a.jahr, ende, _dt.date.today(),
        kapitalgesellschaft=not rahmen.ueberschussrechnung,
        umsatzsteuerpflichtig=not rahmen.ueberschussrechnung)
    frist = next((t for t in termine if t["art"] == art), None)

    print(f"{m['name']} — Steuererklärung {a.jahr}")
    if frist:
        print(f"{frist['bezeichnung']}: Frist {fristen._kurz(frist['faellig'])}"
              f" ({frist['grundlage']}), Status {frist['status']}")
    print()

    for p in offen:
        print(f"  PLATZHALTER  {p['zeile']}  {db.eur(p['betrag'])} EUR")
        if p.get("annahme"):
            print(f"               angenommen:      {p['annahme']}")
        if p.get("grund"):
            print(f"               Grund:           {p['grund']}")
        if p.get("aufloesen_durch"):
            print(f"               aufzulösen durch: {p['aufloesen_durch']}")
        print()

    for a in spec.get("abschnitte", []):
        for z in a["zeilen"]:
            if z.get("abweichung"):
                print(f"  ABWEICHUNG   {z['text']}")
                print(f"               Erklärung {db.eur(z['betrag'])}"
                      f" gegen Konten {db.eur(z.get('konten_saldo', 0))}"
                      f" — Differenz {db.eur(z['abweichung'])} EUR")
                print()
    for p in spec.get("positionen", []):
        if p.get("abweichung"):
            print(f"  ABWEICHUNG   {p['text']}")
            print(f"               Erklärung {db.eur(p['betrag'])}"
                  f" gegen Konto {p['konto']} {db.eur(p.get('konten_saldo', 0))}"
                  f" — Differenz {db.eur(p['abweichung'])} EUR")
            print()

    d = pruefung.alles(con, g, rahmen)
    for b in d["befunde"]:
        if b["schwere"] == "fehler":
            print(f"  FEHLER       {b['text']}")

    # Offene Entscheidungen, an denen die Erklaerung haengt. Ein Punkt in
    # offene_punkte.json mit `blockiert: [...]` sperrt genauso wie ein
    # Platzhalter: die Zahl steht, aber ob sie so in die Erklaerung gehoert,
    # ist nicht entschieden. Dazu Formularzeilen der Ausfuellhilfe, die an
    # einem offenen Punkt haengen, und Gegenproben, die nicht aufgehen.
    from bhl import elster as _elster
    from bhl import offen as _offen
    arten = {art, "gewerbesteuer"} if art == "koerperschaftsteuer" else {art}
    haengt = []
    for p in _offen.laden(jd).get("punkte", []):
        if (set(p.get("blockiert") or []) & arten
                and p.get("status") not in ("behoben", "erledigt", "entschieden")):
            haengt.append(p)
            print(f"  ENTSCHEIDUNG {p['id']}  {p['titel']}")
            if p.get("aktion"):
                print(f"               zu tun: {p['aktion']}")
            print()
    stamm = dict(m)
    mpfad = os.path.join(mandant_dir(m["kuerzel"]), "mandant.json")
    if os.path.exists(mpfad):
        with open(mpfad, encoding="utf-8") as fh:
            stamm.update(json.load(fh))
    gjrow = con.execute("SELECT beginn, ende FROM geschaeftsjahr WHERE id=?", (g,)).fetchone()
    el = _elster.auswerten(con, g, stamm, jd, {"beginn": gjrow[0], "ende": gjrow[1]})
    gp_fehler = [p for p in (el or {}).get("gegenproben", []) if not p["ok"]]
    for p in gp_fehler:
