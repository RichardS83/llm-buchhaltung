def cmd_serve(a):
    from bhl import web
    # Die Oberflaeche zeigt beide Datenbanken nebeneinander - die Dateien
    # bleiben getrennt, der Umschalter im Kopf nicht.
    pfade = [DB] + [p for p in (db_pfad("buchhaltung"), db_pfad("privat"))
                    if p != DB and os.path.exists(p)]
    web.starten(pfade, WURZEL, a.mandant, a.jahr, a.port, oeffnen=not a.kein_browser)


def cmd_konto(a):
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    print(reports.kontoblatt(con, gj(con, m["id"], a.jahr), a.nummer))


def cmd_reset(a):
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    g = gj(con, m["id"], a.jahr)
    con.execute("UPDATE banktransaktion SET buchung_id=NULL WHERE buchung_id IN "
                "(SELECT id FROM buchung WHERE gj_id=?)", (g,))
    con.execute("DELETE FROM buchung WHERE gj_id=?", (g,))
    con.commit()
    print(f"Buchungen {a.jahr} geloescht.")


def main():
