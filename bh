    einlesen(con, gj(con, m["id"], a.jahr), m["id"], a.datei, "Eroeffnungsbuchungen")


def cmd_import_bank(a):
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    dateien = [f for muster in a.dateien for f in sorted(glob.glob(muster))]
    stamm = json.loads(m["stammdaten"]) if m["stammdaten"] else {}
    kopfzeilen = tuple(stamm.get("kontoauszug_kopfzeilen") or ())
    ges_neu = ges_dopp = 0
    for f in dateien:
        auszug = coba.parse_auszug(f, kopfzeilen)
        ok, diff = coba.pruefe(auszug)
        bk = con.execute("SELECT id FROM bankkonto WHERE mandant_id=? AND iban=?",
                         (m["id"], auszug.iban)).fetchone()
        if not bk:
            print(f"  ! IBAN {auszug.iban} nicht konfiguriert - {os.path.basename(f)} uebersprungen")
            continue
        neu = dopp = 0
        for u in auszug.umsaetze:
            if not u.buchungsdatum.startswith(str(a.jahr)):
                continue
            try:
                con.execute("INSERT INTO banktransaktion (bankkonto_id, auszug, buchungsdatum,"
                            " valuta, betrag_cent, text, hash) VALUES (?,?,?,?,?,?,?)",
                            (bk[0], auszug.nummer, u.buchungsdatum, u.valuta,
                             u.betrag_cent, u.text, u.hash))
                neu += 1
            except Exception:
                dopp += 1
        ges_neu += neu; ges_dopp += dopp
        print(f"  {auszug.iban} Auszug {auszug.nummer}: {neu} neu, {dopp} bereits vorhanden, "
              f"Kontrollrechnung {'OK' if ok else 'DIFFERENZ ' + db.eur(diff)}")
    con.commit()
    print(f"Gesamt: {ges_neu} neue Umsaetze, {ges_dopp} Dubletten.")


