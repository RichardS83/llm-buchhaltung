def pruefergebnis(r):
    from bhl import eric
    if r.code == eric.HINWEISE:
        print("OK  Datensatz plausibel, mit Hinweisen.")
    else:
        print(("OK  " if r.ok else "FEHLER  ") + r.text)
    for t in r.fehler:
        print(f"  ! {t}")
    for t in r.hinweise:
        print(f"  Hinweis: {t}")


def cmd_eric(a):
    """ELSTER-Übermittlung über ERiC - Einrichtung und Ablauf in docs/eric.md."""
    from bhl import eric, eric_ansicht, zugang
    from bhl import eric_vorgang as ev
    from bhl import umsatzsteuer as ust
    try:
        e = ev.Einstellung.laden()
    except ev.VorgangFehler as f:
        sys.exit(str(f))
    sdk = os.path.dirname(os.path.abspath(e.bibliothek))

    def versionsprobe(er):
        v = er.version()
        jetzt, naechste = eric.mindestversion()
        haupt = int(v.split(".")[0]) if v[:2].isdigit() else 0
        print(f"ERiC {v} ({e.bibliothek})")
        if haupt and haupt < jetzt:
            print(f"  ! Mindestversion ist ERiC {jetzt} - mit {haupt} nimmt ELSTER nichts "
                  f"mehr an. Neues SDK im Entwicklerbereich laden.")
        elif haupt and haupt < naechste:
            print(f"  Hinweis: ab Ende April gilt voraussichtlich ERiC {naechste} als "
                  f"Mindestversion.")

    if a.aktion == "einrichten":
        try:
            plugins = eric.einrichten(e.bibliothek)
        except eric.EricFehler as f:
            sys.exit(str(f))
        print(f"{len(plugins)} Plugins verlinkt nach {os.path.join(sdk, eric.PLUGIN_VERZEICHNIS)}.")
        if not eric.hinweise_bestaetigt(e.bibliothek):
            print()
            print(eric.DATENSCHUTZHINWEIS)
            print()
            print(eric.PROTOKOLLHINWEIS)
            print()
            print("Das Informationsschreiben der Finanzverwaltung zur DSGVO (Art. 12-14) steht")
            print(f"als Anhang 2 in {os.path.join(sdk, 'lizenz.pdf')}.")
            if not sys.stdin.isatty():
                sys.exit("Die Kenntnisnahme bestätigt ein Mensch: bh eric einrichten in einem "
                         "Terminal ausführen.")
            if input("Zur Kenntnis genommen? [ja/nein] ").strip().lower() != "ja":
                sys.exit("Nicht bestätigt - ERiC bleibt gesperrt.")
            eric.hinweise_bestaetigen(e.bibliothek)
        with eric.Eric(e.bibliothek, os.path.join(sdk, eric.PLUGIN_VERZEICHNIS, "protokoll")) as er:
            versionsprobe(er)
            if a.mandant:
                stamm = ev.stammdaten(mandant_dir(a.mandant))
                pfad = (stamm.get("elster") or {}).get("zertifikat")
                if not pfad:
                    sys.exit('mandant.json: "elster": {"zertifikat": "<pfad.pfx>"} fehlt.')
                try:
                    z = er.zertifikat(pfad, zugang.eric_pin(a.mandant))
                except (eric.EricFehler, zugang.ZugangFehlt) as f:
                    sys.exit(f"Zertifikat {pfad}: {f}")
                bis = z["gueltig_bis"] or "?"
                if bis.count("-") == 2:
                    bis = ".".join(reversed(bis.split("-")))
                print(f"Zertifikat {os.path.basename(pfad)}: PIN stimmt, gültig bis {bis}.")
        return

    if a.aktion == "postfach":
        from bhl import eric_postfach as ep
        if not a.mandant:
            sys.exit("bh eric postfach <mandant>")
        md = mandant_dir(a.mandant)
        try:
            r = ep.abrufen(a.mandant, md, e)
        except (ep.PostfachFehler, eric.EricFehler) as f:
            sys.exit(str(f))
        for s_ in r.status:
            print(f"  {s_['datenart']:<24} {s_['anzahl']:>4}")
        print(f"{len(r.neu)} neu abgeholt, {len(r.vorhanden)} schon vorhanden.")
        for i, b in r.bestaetigt.items():
            print(f"  bestätigt {i}: {b['code']} {b['text']}")
        print("  ansehen: bh serve, Seite ELSTER-Postfach")
        return

    if not (a.mandant and a.jahr and a.art):
        sys.exit("bh eric pruefen|test|senden <mandant> <jahr> ustva|zm --quartal N "
                 "| ebilanz | eroeffnung | kst | gewst")
    if not eric.hinweise_bestaetigt(e.bibliothek):
        sys.exit("Zuerst: bh eric einrichten (Datenschutzhinweise nach der ERiC-Lizenz).")
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    if a.art in ev.JAHRESARTEN:
        # Die E-Bilanz gilt dem ganzen Wirtschaftsjahr, auch einem Rumpfjahr;
        # KSt und GewSt dem Veranlagungszeitraum, in dem es endet
        try:
            z = ev.zeitraum(con, m["id"], a.jahr, ev.ZEITRAUM[a.art])
        except ev.VorgangFehler as f:
            sys.exit(str(f))
    elif not (a.quartal or a.monat):
        sys.exit("--quartal oder --monat angeben.")
    else:
        z = ust.Zeitraum(a.jahr, quartal=a.quartal, monat=a.monat)
    md = mandant_dir(a.mandant)

    if (a.vorlegen or a.aenderung) and a.aktion != "pruefen":
        sys.exit("--vorlegen gilt nur für bh eric pruefen.")
    try:
        aenderungen = [ev.aenderung(t) for t in a.aenderung]
    except ev.VorgangFehler as f:
        sys.exit(str(f))
    if (a.aenderung or a.pruefpunkt) and not a.vorlegen:
        sys.exit("--aenderung und --pruefpunkt nur zusammen mit --vorlegen.")

    if a.aktion == "senden" and not sys.stdin.isatty():
        sys.exit("Die Abgabe gibt ein Mensch frei: bh eric senden in einem Terminal oder "
                 "über bh serve. Zum Probieren: bh eric test.")

    def zeigen(ds, vp):
        print(f"{ev.TITEL[a.art]} {z.bezeichnung}" + (" - berichtigt" if a.berichtigt else ""))
        for name, wert in ds.zeilen:
            print(f"  {name:<14} {wert:>14}")
        if vp:
            print("\nPlausibilitätsprüfung vor dem Senden:")
            pruefergebnis(vp)

    def freigabe(ds, vp, pruefung):
        zeigen(ds, vp)
        print()
        if pruefung and pruefung["datensatz"]["sha256"] == ev.sha256(ds.xml):
            print(f"Datensatz identisch mit der Prüfung vom "
                  f"{pruefung['zeit'][:16].replace('T', ' ')} "
                  f"(SHA-256 {pruefung['datensatz']['sha256'][:12]}…).")
        elif pruefung:
            print(f"  ! Datensatz weicht von der Prüfung vom "
                  f"{pruefung['zeit'][:16].replace('T', ' ')} ab - seitdem hat sich die "
                  f"Buchführung oder das Erstellungsdatum geändert.")
        print("Das ist die Abgabe an die Finanzverwaltung - ohne Testmerker.")
        if vp.hinweise:
            print(f"Es gibt {len(vp.hinweise)} Hinweis(e) - bitte oben lesen.")
        betrag = ev.betrag_text(ds.betrag_cent)
        was = ev.FREIGABE.get(a.art, "Betrag")
        if input(f"Zur Freigabe {was} eingeben ({betrag}): ").strip() != betrag:
            raise ev.VorgangFehler("Nicht freigegeben - nichts gesendet.")

    with eric.Eric(e.bibliothek, ev.protokoll(md)) as er:
        versionsprobe(er)
    try:
        v = ev.durchfuehren(con, m["id"], a.mandant, md, z, a.art, a.aktion, e,
                            berichtigt=a.berichtigt, testzertifikat=a.testzertifikat,
                            freigabe=freigabe)
    except ev.VorgangFehler as f:
        lauf = getattr(f, "lauf", None)
        if lauf:
            zeigen(lauf.datensatz, None)
            print("\nPlausibilitätsprüfung vor dem Senden:")
            vp_datei = lauf.dateien.get("vorpruefung")
            if vp_datei:
                for mld in eric_ansicht.meldungen(open(vp_datei, encoding="utf-8").read()):
                    print(f"  {'!' if mld['art'] == 'fehler' else 'Hinweis:'} {mld['text']}"
                          + (f" (Feld {mld['feld']})" if mld["feld"] else ""))
            print(f"  abgelegt in {os.path.relpath(lauf.ordner, WURZEL)}")
        sys.exit(str(f))

    if a.aktion != "senden":
        zeigen(v.datensatz, v.vorpruefung)
    r = v.lauf.ergebnis
    print()
    if a.aktion != "pruefen":
        print("Übermittlung:")
    pruefergebnis(r)
    if r.transferticket:
        print(f"  Transferticket {r.transferticket}")
    print(f"  abgelegt in {os.path.relpath(v.lauf.ordner, WURZEL)}")
    if a.vorlegen and r.ok:
        ev.vorschlagen(v.lauf.ordner, a.vorlegen, aenderungen, von=a.von,
                       pruefpunkte=a.pruefpunkt)
        print(f"  zur Freigabe vorgelegt ({len(aenderungen)} Änderung(en)) — "
              f"bh serve, ELSTER-Übermittlungen, „Zur Freigabe“")
    elif a.vorlegen:
        print("  nicht vorgelegt: die Prüfung hat Fehler")
    print("  ansehen: bh serve, Seite ELSTER-Übermittlungen")
    if v.festgehalten:
        datei = "fristen.csv" if a.art in ev.JAHRESARTEN else "voranmeldungen.csv"
        print(f"  festgehalten in {os.path.relpath(os.path.join(md, datei), WURZEL)}")
    if not r.ok:
        sys.exit(1)


