def cmd_umsaetze(a):
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    # `jahr 0` sucht ueber alle Jahre - beim Archiv der privaten Konten der
    # Normalfall, weil ein Vorgang selten in ein Kalenderjahr faellt.
    jahr = "%" if a.jahr == 0 else f"{a.jahr}%"
    werte = [m["id"], jahr]
    q = ("SELECT t.id, k.iban, t.buchungsdatum, t.betrag_cent, t.text, t.buchung_id"
         " FROM banktransaktion t JOIN bankkonto k ON k.id=t.bankkonto_id"
         " WHERE k.mandant_id=? AND t.buchungsdatum LIKE ?"
         + (" AND t.buchung_id IS NULL" if a.offen else ""))
    for wort in (a.suche or []):
        q += " AND t.text LIKE ?"
        werte.append(f"%{wort}%")
    if a.ab_betrag:
        q += " AND ABS(t.betrag_cent) >= ?"
        werte.append(int(round(float(a.ab_betrag.replace(".", "").replace(",", ".")) * 100)))
    q += " ORDER BY t.buchungsdatum, t.id"
    for r in con.execute(q, werte):
        print(f"{r['id']:>4} {r['buchungsdatum']} {r['iban'][-4:]} "
              f"{db.eur(r['betrag_cent']):>13}  {' '.join(r['text'].split())[:110]}")


def cmd_buchen(a):
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    g = gj(con, m["id"], a.jahr)
    einlesen(con, g, m["id"], a.datei, "Buchungen")
    s, h = ledger.probe(con, g)
    print(f"Summe Soll {db.eur(s)} / Haben {db.eur(h)} "
          f"{'(ausgeglichen)' if s == h else '*** DIFFERENZ ***'}")


def cmd_beleg(a):
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    md = mandant_dir(a.mandant)
    if a.aktion == "add":
        _, nr, neu = blg.erfassen(con, m["id"], md, a.ziel, jahr=a.jahr, datum=a.datum,
                                  kategorie=a.kategorie, aussteller=a.aussteller,
                                  bezeichnung=a.bezeichnung,
                                  betrag_cent=db.cent(a.betrag) if a.betrag else None)
        con.commit()
        print(f"{nr} {'angelegt' if neu else 'bereits vorhanden'}")
    elif a.aktion == "scan":
        neu, alt = blg.scannen(con, m["id"], md, a.ziel, jahr=a.jahr)
        con.commit()
        print(f"{neu} Belege neu abgelegt, {alt} bereits vorhanden.")
    elif a.aktion == "list":
        print(reports.belegliste(con, m["id"], a.jahr))


def cmd_report(a):
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    g = gj(con, m["id"], a.jahr)
    vj = vorjahr.gj_id(con, m["id"], a.jahr - 1)
    text = {
        "saldenliste": lambda: reports.saldenliste(con, g),
        "bilanz": lambda: reports.bilanz(con, g, vj),
        "guv": lambda: reports.guv(con, g, vj),
        "journal": lambda: reports.journal(con, g),
        "belege": lambda: reports.belegliste(con, m["id"], a.jahr),
        "anlagen": lambda: reports.anlagen(con, g, vj),
    }[a.was]()
    print(text)
    if a.out:
        open(a.out, "w", encoding="utf-8").write(text + "\n")


def cmd_import_est(a):
    """Eine ausgefertigte Einkommensteuererklaerung als Vergleichsjahr buchen."""
    from bhl.importers import est_erklaerung as est
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    anlagen = est.anlagen_v(a.datei)
    mantel = est.mantelbogen(a.datei)
    g = ledger.gj_anlegen(con, m["id"], a.jahr)
    con.execute("DELETE FROM buchung WHERE gj_id=? AND art='vorjahr'", (g,))
    for datum, text, zeilen in (est.buchungszeilen(anlagen, a.jahr)
                                + [est.mantel_buchung(mantel, a.jahr)]):
        ledger.buchen(con, g, m["id"], datum, text, zeilen,
                      belegfeld=f"ESt{a.jahr}", art="vorjahr")
    con.execute("UPDATE geschaeftsjahr SET status='abgeschlossen' WHERE id=?", (g,))
    con.commit()
    for x in anlagen:
        print(f"  Anlage V Nr. {x.nr}: Einnahmen {x.einnahmen:>9} ./. Werbungskosten "
              f"{x.werbungskosten:>9} = {x.ergebnis:>9}")
    print(f"  Vermietung und Verpachtung gesamt {sum(x.ergebnis for x in anlagen):>25}")
    print(f"  Gesamtbetrag der Einkünfte        {mantel['gesamtbetrag']:>25}")
    print(f"  zu versteuerndes Einkommen        {mantel['zve']:>25}")
    print(f"\n{len(anlagen)} Anlagen V und der Mantelbogen aus "
          f"{os.path.basename(a.datei)} gebucht.")


def cmd_pruefen(a):
    from bhl import pruefung
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    g = gj(con, m["id"], a.jahr)
    d = pruefung.alles(con, g, rahmen_aus_mandant(m),
                       jahr_dir(a.mandant, a.jahr))
    for b in d["befunde"]:
        print(f"[{b['schwere']:>7}] {b['text']}")
    if not d["befunde"]:
        print(f"{m['name']} {a.jahr}: keine Beanstandungen.")
    else:
        print(f"\n{d['fehler']} Fehler, {d['hinweise']} Hinweise.")
    sys.exit(1 if d["fehler"] else 0)


def cmd_abgabe(a):
    """Die Freigabe vor der Abgabe - ein Befehl, der Nein sagen kann.

    Die Erklaerung wird von Hand in Mein Elster uebertragen; es gibt keinen
    Knopf, den ein Programm sperren koennte. Was sich sperren laesst, ist die
    Aussage "sie ist fertig". Genau die gibt dieser Befehl - oder eben nicht,
    mit Rueckgabewert 1, damit auch ein Skript daran haengen kann.
    """
    from bhl import fristen, pruefung
    from bhl import steuern as st
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)
    g = gj(con, m["id"], a.jahr)
    rahmen = rahmen_aus_mandant(m)
    jd = jahr_dir(a.mandant, a.jahr)

    spec = st.laden(jd)
    if spec is None:
        sys.exit(f"Fehlt: {os.path.join(jd, 'steuern.json')}")
    offen = st.platzhalter(spec)

    art = "einkommensteuer" if rahmen.ueberschussrechnung else "koerperschaftsteuer"
    ende = con.execute("SELECT ende FROM geschaeftsjahr WHERE id=?", (g,)).fetchone()[0]
    import datetime as _dt
    termine = fristen.jahrespflichten(
        mandant_dir(a.mandant), a.jahr, ende, _dt.date.today(),
        kapitalgesellschaft=not rahmen.ueberschussrechnung,
        umsatzsteuerpflichtig=not rahmen.ueberschussrechnung)
    frist = next((t for t in termine if t["art"] == art), None)

    print(f"{m['name']} — Steuererklärung {a.jahr}")
    if frist:
        print(f"{frist['bezeichnung']}: Frist {fristen._kurz(frist['faellig'])}"
              f" ({frist['grundlage']}), Status {frist['status']}")
    print()

    for p in offen:
        print(f"  PLATZHALTER  {p['zeile']}  {db.eur(p['betrag'])} EUR")
        if p.get("annahme"):
            print(f"               angenommen:      {p['annahme']}")
        if p.get("grund"):
            print(f"               Grund:           {p['grund']}")
        if p.get("aufloesen_durch"):
            print(f"               aufzulösen durch: {p['aufloesen_durch']}")
        print()

    d = pruefung.alles(con, g, rahmen)
    for b in d["befunde"]:
        if b["schwere"] == "fehler":
            print(f"  FEHLER       {b['text']}")

    gesperrt = bool(offen) or d["fehler"]
    print()
    if gesperrt:
        teile = []
        if offen:
            teile.append(f"{len(offen)} Platzhalter")
        if d["fehler"]:
            teile.append(f"{d['fehler']} Fehler in der Buchführung")
        print(f"GESPERRT — {' und '.join(teile)}. Die Erklärung ist nicht abgabefähig.")
    else:
        print("FREI — keine Platzhalter, keine Fehler. Die Erklärung kann abgegeben werden.")
    sys.exit(1 if gesperrt else 0)


def cmd_ustva(a):
    import csv as _csv

    from bhl import umsatzsteuer as ust
    con = db.connect(DB)
    m = lade_mandant(con, a.mandant)

    # Abgabestand aus mandanten/<kuerzel>/voranmeldungen.csv nachziehen
    stand_datei = os.path.join(mandant_dir(a.mandant), "voranmeldungen.csv")
    if os.path.exists(stand_datei):
        with open(stand_datei, encoding="utf-8") as fh:
            zeilen = [z for z in fh if not z.lstrip().startswith("#")]
        for r in _csv.DictReader(zeilen, delimiter=";"):
            z = ust.zeitraum_aus_code(int(r["jahr"]), r["zeitraum"])
            ust.festhalten(con, m["id"], z, (r["status"] or "offen").strip(),
                           transferticket=(r.get("transferticket") or "").strip() or None,
                           abgegeben_am=(r.get("abgegeben_am") or "").strip() or None,
                           zahlung_am=(r.get("zahlung_am") or "").strip() or None,
                           notiz=(r.get("notiz") or "").strip() or None,
                           art=(r.get("art") or "ustva").strip())
        con.commit()

    zeitraeume = [z for z in ust.quartale(con, m["id"]) if z.jahr == a.jahr]
    if a.quartal:
        zeitraeume = [z for z in zeitraeume if z.quartal == a.quartal]
    for z in zeitraeume:
        print(ust.eingabeblatt(con, m["id"], z, mandant_dir(a.mandant)))
        print()


def cmd_link(a):
