"""bh - kleine Buchhaltung, doppelte Buchfuehrung.

Zwei Betriebsarten, dieselbe Mechanik:
  * Kapitalgesellschaften nach HGB (Bilanz, GuV, Jahresabschluss)
  * private Einkommensteuer nach § 11 EStG (Ueberschussrechnung, Anlage V)

Die Datenbank waehlt `--db`. Vorgabe ist `buchhaltung.sqlite` (die
Gesellschaften); die privaten Buchungen liegen in `privat.sqlite`, getrennt,
weil bei einer Betriebspruefung nach § 147 Abs. 6 AO Datenzugriff auf die
betrieblichen Daten besteht - eine gemeinsame Datei macht die Trennung dann
zur Handarbeit.

Aufrufe:
  bh [--db <name>] <befehl> ...
  bh init <mandant> <jahr>                 Mandant + Geschaeftsjahr + Kontenplan anlegen
  bh eb <mandant> <jahr> <eb.csv>          Eroeffnungsbilanzwerte buchen
  bh import-bank <mandant> <jahr> <pdf...> Commerzbank-Kontoauszuege einlesen
  bh umsaetze <mandant> <jahr> [--offen] [--suche W] [--ab-betrag N]
                                           importierte Bankumsaetze; Jahr 0 = alle
  bh buchen <mandant> <jahr> <buchungen.csv>
  bh beleg add <mandant> <datei> [opts]    Beleg ins Archiv legen
  bh beleg scan <mandant> <ordner> [--jahr]
  bh beleg list <mandant> [--jahr]
  bh link <mandant> <jahr>                 Buchung <-> Bankumsatz <-> Beleg verknuepfen
  bh vorjahr <mandant> <jahr>              Vorjahressalden aus dem Abschluss uebernehmen
  bh report <mandant> <jahr> <was>         saldenliste|bilanz|guv|journal|belege
  bh konto <mandant> <jahr> <kontonummer>
  bh serve <mandant> <jahr> [--port]       Web-Oberflaeche starten
  bh pruefen <mandant> <jahr>              Buchfuehrung auf Regelverstoesse pruefen
  bh abgabe <mandant> <jahr>               Darf die Erklaerung abgegeben werden?
  bh reset <mandant> <jahr>                alle Buchungen des Jahres loeschen
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from bhl import belege as blg
from bhl import db, ledger, reports, verknuepfung, vorjahr
from bhl.importers import commerzbank as coba
from bhl.kontenplan import aus_mandant as rahmen_aus_mandant
from bhl.kontenplan import lade as lade_rahmen

WURZEL = os.path.dirname(os.path.abspath(__file__))
DB = os.path.join(WURZEL, "buchhaltung.sqlite")


def db_pfad(name: str) -> str:
    """`--db` nimmt einen Kurznamen ('privat') oder einen vollen Pfad."""
    if os.sep in name or name.endswith(".sqlite"):
        return os.path.abspath(name)
    return os.path.join(WURZEL, f"{name}.sqlite")


def mandant_dir(kuerzel: str) -> str:
    return os.path.join(WURZEL, "mandanten", kuerzel)


def jahr_dir(kuerzel: str, jahr: int) -> str:
    return os.path.join(mandant_dir(kuerzel), str(jahr))


def lade_mandant(con, kuerzel: str):
    r = con.execute("SELECT * FROM mandant WHERE kuerzel=?", (kuerzel,)).fetchone()
    if not r:
        sys.exit(f"Mandant '{kuerzel}' unbekannt. Zuerst 'bh init' ausfuehren.")
    return r


def gj(con, mandant_id: int, jahr: int) -> int:
    r = con.execute("SELECT id FROM geschaeftsjahr WHERE mandant_id=? AND jahr=?",
                    (mandant_id, jahr)).fetchone()
    if not r:
        sys.exit(f"Geschaeftsjahr {jahr} nicht angelegt.")
    return r[0]


def quelle_von(pfad: str) -> str:
    """Kennung der Buchungsdatei, unter der ihre Buchungen in der Datenbank
    stehen. Relativ zum Projekt, damit ein Umzug des Ordners sie nicht
    umbenennt und derselbe Lauf von ueberall dasselbe Ergebnis hat."""
    voll = os.path.abspath(pfad)
    rel = os.path.relpath(voll, WURZEL)
    return f"datei:{rel if not rel.startswith('..') else voll}"


def einlesen(con, g: int, mandant_id: int, pfad: str, wort: str) -> None:
    """Buchungsdatei einlesen und berichten, was sich geaendert hat.

    Die Datei ist die Wahrheit, die Datenbank ihr Abbild: derselbe Lauf zweimal
    aendert nichts. Was schon dasteht, behaelt Nummer, Bankumsatz und Beleg.
    """
    b = ledger.buchungen_aus_csv(con, g, mandant_id, pfad, quelle=quelle_von(pfad))
    con.commit()
    teile = [f"{b[k]} {wort2}" for k, wort2 in
             (("neu", "neu"), ("uebernommen", "uebernommen"),
              ("unveraendert", "unveraendert"), ("entfernt", "entfernt")) if b[k]]
    print(f"{b['gesamt']} {wort} in {os.path.relpath(os.path.abspath(pfad), WURZEL)}"
          f" ({', '.join(teile) or 'nichts geaendert'}).")


