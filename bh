    m = lade_mandant(con, a.mandant)
    g = gj(con, m["id"], a.jahr)
    r = verknuepfung.alles(con, m["id"], g, os.path.join(mandant_dir(a.mandant), str(a.jahr)))
    con.commit()
    print(f"{r['bankumsaetze']} Bankumsaetze mit ihrer Buchung verknuepft,\n"
          f"{r['kontoauszuege']} Buchungen an ihren Kontoauszug gehaengt,\n"
          f"{r['manuell']} Verknuepfungen aus belege_zuordnung.csv,\n"
          f"{r['ohne_buchung']} Umsaetze als bewusst nicht gebucht vermerkt.")
    for f in r["fehler"]:
        print(f"  ! {f}")
    o = verknuepfung.offen(con, m["id"], g)
    print(f"Offen: {o['umsaetze_ohne_buchung']} Bankumsaetze ohne Buchung, "
          f"{o['buchungen_ohne_beleg']} Buchungen ohne Beleg, "
          f"{o['belege_ohne_buchung']} Belege ohne Buchung.")


