    abw = spec.get("abweichungen", 0)
    gesperrt = bool(offen) or d["fehler"] or abw or bool(haengt) or bool(gp_fehler)
    print()
    if gesperrt:
        teile = []
        if haengt:
            teile.append(f"{len(haengt)} offene Entscheidung{'en' if len(haengt) > 1 else ''}"
                         f" ({', '.join(p['id'] for p in haengt)})")
        if gp_fehler:
            teile.append(f"{len(gp_fehler)} Gegenprobe(n) der Ausfüllhilfe")
        if offen:
            teile.append(f"{len(offen)} Platzhalter")
        if abw:
            teile.append(f"{abw} Abweichung{'en' if abw > 1 else ''}"
                         " zwischen Erklärung und Konten")
        if d["fehler"]:
            teile.append(f"{d['fehler']} Fehler in der Buchführung")
        print(f"GESPERRT — {' und '.join(teile)}. Die Erklärung ist nicht abgabefähig.")
