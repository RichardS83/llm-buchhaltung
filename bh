def _antwortet(port):
    """Laeuft auf dem Port bereits *unsere* Oberflaeche? Nicht irgendein Dienst."""
    import json as _json
    import urllib.error
    import urllib.request
    try:
        with urllib.request.urlopen(
                f"http://127.0.0.1:{port}/api/mandanten", timeout=1) as r:
            return isinstance(_json.loads(r.read().decode("utf-8")), (list, dict))
    except (urllib.error.URLError, OSError, ValueError):
        return False


def cmd_serve(a):
    from bhl import web
    adresse = f"http://127.0.0.1:{a.port}/"

    if getattr(a, "ensure", False):
        # Idempotent: laeuft die Oberflaeche schon, wird kein zweiter Server
        # gestartet - es wird nur der Link ausgegeben.
        if _antwortet(a.port):
            print(adresse)
            return
        import subprocess
        import tempfile
        protokoll = tempfile.NamedTemporaryFile(
            prefix="bh-serve-", suffix=".log", delete=False)
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--db", a.db, "serve",
             a.mandant, str(a.jahr), "--port", str(a.port), "--kein-browser"],
            cwd=WURZEL, stdout=protokoll, stderr=subprocess.STDOUT,
            start_new_session=True)
        for _ in range(40):                       # bis zu 10 Sekunden
            if _antwortet(a.port):
                print(adresse)
                return
            time.sleep(0.25)
        protokoll.close()
        print(f"Oberflaeche kam auf Port {a.port} nicht hoch. Protokoll: "
              f"{protokoll.name}", file=sys.stderr)
        raise SystemExit(1)

    # Die Oberflaeche zeigt beide Datenbanken nebeneinander - die Dateien
    # bleiben getrennt, der Umschalter im Kopf nicht.
    pfade = [DB] + [p for p in (db_pfad("buchhaltung"), db_pfad("privat"))
                    if p != DB and os.path.exists(p)]
    try:
        web.starten(pfade, WURZEL, a.mandant, a.jahr, a.port,
                    oeffnen=not a.kein_browser)
    except OSError as e:
        if e.errno != errno.EADDRINUSE:
            raise
        laeuft = "unsere Oberflaeche" if _antwortet(a.port) else "ein anderer Dienst"
        raise SystemExit(
            f"Port {a.port} ist belegt - dort laeuft bereits {laeuft}.\n"
            f"Entweder {adresse} benutzen oder mit --port einen anderen waehlen.")


