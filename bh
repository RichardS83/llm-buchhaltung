def cmd_init(a):
    con = db.connect(DB)
    cfg_pfad = os.path.join(mandant_dir(a.mandant), "mandant.json")
    if not os.path.exists(cfg_pfad):
        sys.exit(f"Fehlt: {cfg_pfad}")
    cfg = json.load(open(cfg_pfad, encoding="utf-8"))
    bank = cfg.pop("bankkonten", [])
    rahmen = lade_rahmen(cfg.get("kontenrahmen"), cfg)
    # Was der Kontenrahmen aus der Konfiguration braucht, wandert mit in die
    # Datenbank: Auswertungen bauen den Rahmen spaeter aus der Mandantenzeile
    # auf und haben die Datei dann nicht zur Hand.
    stamm = {k: cfg[k] for k in ("objekte", "kontobezeichnungen",
                                 "kontoauszug_kopfzeilen", "belegregeln") if k in cfg}
    cfg["stammdaten"] = json.dumps(stamm, ensure_ascii=False) if stamm else None
    # mandant.json traegt auch Bloecke, die keine Spalte sind (z.B. "umsatzsteuer").
    # Sie bleiben in der Datei und werden dort gelesen, wo sie gebraucht werden.
    spalten = {r[1] for r in con.execute("PRAGMA table_info(mandant)")}
    mid = ledger.mandant_anlegen(con, **{k: v for k, v in cfg.items() if k in spalten})
    ledger.konten_anlegen(con, mid, rahmen.konten)
    ledger.gj_anlegen(con, mid, a.jahr)
    for b in bank:
        con.execute("INSERT OR IGNORE INTO bankkonto (mandant_id, iban, bezeichnung,"
                    " konto_id, nur_archiv) VALUES (?,?,?,?,?)",
                    (mid, b["iban"], b["bezeichnung"], ledger.konto_id(con, mid, b["konto"]),
                     1 if b.get("nur_archiv") else 0))
    con.commit()
    print(f"Mandant {cfg['name']} (id {mid}), Geschaeftsjahr {a.jahr}, Kontenrahmen "
          f"{rahmen.name} mit {len(rahmen.konten)} Konten, {len(bank)} Bankkonten.")


def cmd_eb(a):
